# PostgreSQL 实例(承载应用库 + 所有 product 库)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MAINTENANCE_DB=postgres

# 应用库(用户/鉴权/产品登记/配置)
APP_DB_NAME=mem0_app

# product 库命名:前缀 + product_id(其中 '-' -> '_')
PRODUCT_DB_PREFIX=mem0_

# 连接池
PG_POOL_MINCONN=1
PG_POOL_MAXCONN=5

# LLM / Embedder(mem0 provider 配置)
OPENAI_API_KEY=
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=gpt-4.1-nano-2025-04-14
MEM0_LLM_TEMPERATURE=0.2
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# 鉴权(AUTH_DISABLED=true 仅本地开发)
AUTH_DISABLED=false
ADMIN_API_KEY=

# 服务
HOST=0.0.0.0
PORT=8000
